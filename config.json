{
  "whatsapp": {
    "authDir": "auth",
    "groupIds": [],
    "pairingNumber": "",
    "trigger": "@game",
    "startTrigger": "@start",
    "replyTemplate": "🏎️ Smash Karts: {weapons} on {arena}, {format}, {minutes} min rounds\n{link}",
    "failureText": "⚠️ Couldn't create the room this time. Try @game again in a minute.",
    "sendFailureScreenshot": true
  },
  "browser": {
    "profileDir": "profile",
    "channel": "",
    "executablePath": "",
    "viewport": { "width": 1280, "height": 720 }
  },
  "game": {
    "url": "https://smashkarts.io/",
    "photonPort443": false,
    "recordingFile": "recordings/create.json",
    "defaults": { "arena": "Smash Island", "weapons": ["Nuke"] },
    "timer": { "options": [3, 6, 10, 20], "startMinutes": 3, "defaultMinutes": 10, "arrow": { "x": 873, "y": 250 } },
    "teamsBox": { "x": 493, "y": 557, "maxDiff": 15 },
    "menuTimeoutMs": 180000,
    "menuSettleMs": 3000,
    "linkTimeoutMs": 20000,
    "createAttempts": 3,
    "roomTtlMinutes": 120,
    "keepAliveSeconds": 20,
    "menuRefreshMinutes": 60
  },
  "replay": {
    "speed": 1,
    "minGapMs": 300,
    "maxGapMs": 6000,
    "visualCheck": true,
    "strictVisual": true,
    "minSimilarity": 0.8,
    "visualThreshold": 30,
    "visualTimeoutMs": 60000,
    "reclickMs": 5000
  },
  "dataDir": "data"
}
